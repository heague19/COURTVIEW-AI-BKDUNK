# COURTVIEW Desktop Environment Variables

# Server Settings
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
DEBUG=false

# GPU Settings
CUDA_VISIBLE_DEVICES=0
GPU_MEMORY_FRACTION=0.9

# Storage Settings
STORAGE_PATH=./storage
VIDEO_PATH=./storage/videos
OUTPUT_PATH=./storage/outputs
DATASET_PATH=./storage/datasets
LOG_PATH=./storage/logs

# Database Settings
DATABASE_URL=sqlite:///./database/courtview.db

# Camera Settings
MIN_CAMERAS=4
MAX_CAMERAS=8

# AI Referee Settings
DEFAULT_RULE_SET=FIBA
CONFIDENCE_THRESHOLD=0.75
MULTI_ANGLE_THRESHOLD=0.75

# Performance Settings
TARGET_FPS=30
BATCH_SIZE=4
NUM_WORKERS=4

# Feature Flags
ENABLE_AI_REFEREE=true
ENABLE_TACTICAL_ANALYSIS=true
ENABLE_VIDEO_EDITING=true
